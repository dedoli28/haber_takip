# Yerel geliştirme için örnek ortam değişkenleri. Gerçek değerleri ASLA repoya yazmayın;
# Vercel'de Project > Settings > Environment Variables bölümünden girin. (.env dosyaları .gitignore'dadır.)

# --- Haber sistemi (mevcut) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
POLL_SECRET=
ALLOWED_ORIGINS=
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# --- Piyasa Görünümü (yeni) ---
# Sağlayıcı: "twelvedata" (bugün desteklenen tek gerçek sağlayıcı). Boş bırakılırsa piyasa
# grafikleri anlaşılır bir "yapılandırılmadı" durumu gösterir; haberler etkilenmez.
MARKET_DATA_PROVIDER=
# Sağlayıcı API anahtarı. YALNIZCA sunucuda okunur; istemciye/HTML'e/JS'e/yanıtlara asla yazılmaz.
MARKET_DATA_API_KEY=
# İsteğe bağlı: dakikada azami sağlayıcı çağrısı (varsayılan 6; Twelve Data ücretsiz planı dakikada 8 kredi verir).
MARKET_DATA_MAX_CALLS_PER_MIN=6

# YALNIZCA yerel geliştirme/test: sahte fiyat serisi. Vercel production ortamında ASLA etkinleşmez.
# MARKET_DATA_PROVIDER=mock
# MARKET_DATA_ALLOW_MOCK=1
